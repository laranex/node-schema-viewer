{
  "name": "node-schema-viewer-embedding-examples",
  "private": true,
  "type": "module",
  "description": "Development-only Schema Viewer embedding examples for Express, Fastify, NestJS and Next.js, with their security tests.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "express": "node express/server.mjs",
    "fastify": "node fastify/server.mjs",
    "nestjs:build": "tsc -p nestjs/tsconfig.json",
    "nestjs": "node nestjs/dist/main.js",
    "nextjs:dev": "next dev nextjs --hostname 127.0.0.1",
    "nextjs:build": "next build nextjs",
    "test": "node --test --test-concurrency=1 --test-timeout=600000 test/*.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "express": "5.3.0",
    "fastify": "5.12.7",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "laranex-schema-viewer-ui": "0.4.0",
    "node-schema-viewer": "file:../..",
    "typescript": "6.0.3"
  }
}
